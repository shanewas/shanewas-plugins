{
  "description": "Verify done: warn when the done claim lacks build, test, or artifact evidence",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/tools/donecheck.py check --json"
          }
        ]
      }
    ]
  }
}
