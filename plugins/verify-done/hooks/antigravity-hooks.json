{
  "_note": "Merge this entry into your project's .agents/hooks.json. Fix the command path to point at your verify-done checkout.",
  "verify-done": {
    "SessionStart": null,
    "PreInvocation": null,
    "PostInvocation": null,
    "Stop": null,
    "PreToolUse": null,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/verify-done/tools/donecheck.py check",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
